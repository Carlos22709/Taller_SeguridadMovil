# Copia este archivo a .env y arranca con: uvicorn app.main:app --env-file .env (opcional)
# Secreto para firmar JWT. Si no se define se genera uno aleatorio en cada arranque.
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# Tiempos de vida (segundos)
ACCESS_TOKEN_TTL=300
REFRESH_TOKEN_TTL=2592000
ELEVATED_TOKEN_TTL=600
STEP_UP_TOKEN_TTL=300
REPLAY_CACHE_TTL=90

# Redirect URIs registradas (exactas, separadas por coma). <origen>/callback siempre se permite.
# Si usas Expo Go agrega la suya, p. ej. exp://192.168.1.20:8081/--/callback
ALLOWED_REDIRECT_URIS=unisabana-auth://callback,http://localhost:8081/callback,http://localhost:8000/callback
CORS_ORIGINS=http://localhost:8081

# Usuario demo y semilla TOTP (Base32)
DEMO_USER_EMAIL=estudiante@unisabana.edu.co
DEMO_USER_PASSWORD=sabana123
TOTP_SECRET=JBSWY3DPEHPK3PXP
