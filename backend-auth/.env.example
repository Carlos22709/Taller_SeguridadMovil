# Copia este archivo a .env y arranca con: uvicorn app.main:app --host 0.0.0.0 --port 8000 --env-file .env
# Todas las variables son opcionales: si no se definen se usan los valores por defecto.

# Secreto para firmar los JWT. Si no se define se genera uno aleatorio en cada arranque.
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# Tiempos de vida (segundos)
ACCESS_TOKEN_TTL=300
REFRESH_TOKEN_TTL=2592000
ELEVATED_TOKEN_TTL=600
STEP_UP_TOKEN_TTL=300
REPLAY_CACHE_TTL=90

# Redirect URIs registradas (exactas, separadas por coma).
ALLOWED_REDIRECT_URIS=unisabana-auth://callback
# Acepta los redirect de Expo Go (exp://<ip>:8081/--/callback). Solo para desarrollo.
ALLOW_EXPO_GO_REDIRECTS=true

# Usuario demo y semilla TOTP (Base32)
DEMO_USER_EMAIL=estudiante@unisabana.edu.co
DEMO_USER_PASSWORD=sabana123
TOTP_SECRET=JBSWY3DPEHPK3PXP
