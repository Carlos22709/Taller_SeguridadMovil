{
  "expo": {
    "name": "UniSabana Seguro",
    "slug": "unisabana-seguro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.edu.unisabana.seguridadmovil"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "co.edu.unisabana.seguridadmovil"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "UniSabana Seguro",
      "themeColor": "#0B3A73"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "La cámara se usa solo para escanear el QR de tu Authenticator.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "unisabana-auth"
  }
}
